{
  "name": "lost-items",
  "type": "module",
  "version": "0.0.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check && astro check",
    "fix": "biome check --write",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply lost-items-db --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "db:rebuild": "rm -rf migrations .wrangler/state/v3/d1 && pnpm db:generate && pnpm db:migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/solid-js": "^7.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@kobalte/core": "^0.13.13",
    "astro": "^7.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "lucide-solid": "^1.31.0",
    "solid-js": "^1.9.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.8",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^27.4.0",
    "lefthook": "^2.1.10",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
