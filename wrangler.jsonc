{
  "name": "lost-items",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lost-items-db",
      "database_id": "60db82e3-112d-4ad3-86bc-ccf860b3c91f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lost-items-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
