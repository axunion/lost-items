---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  showBack?: boolean;
  backUrl?: string;
}

const { title, showBack = false, backUrl = "/" } = Astro.props;
---

<header class="app-header">
	<div class="app-header__inner">
		<div class="app-header__left">
			{showBack && (
				<a href={backUrl} class="app-header__back">
					<Icon name="lucide:chevron-left" class="app-header__back-icon" />
				</a>
			)}
		</div>
		<h1 class="app-header__title">{title}</h1>
		<div class="app-header__right">
			<slot name="right" />
		</div>
	</div>
</header>

<style>
	.app-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background-color: var(--color-background-alpha-85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border-alpha-30);
	}

	.app-header__inner {
		max-width: 32rem;
		margin: 0 auto;
		height: 4rem;
		padding: 0 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: relative;
	}

	.app-header__left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.app-header__back {
		padding: 0.5rem;
		margin-left: -0.5rem;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		color: var(--color-foreground);
		text-decoration: none;
		transition: background-color 150ms;
	}

	.app-header__back:hover {
		background-color: var(--color-secondary);
	}

	.app-header__back-icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	.app-header__title {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 60%;
		text-align: center;
		margin: 0;
	}

	.app-header__right {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
</style>
