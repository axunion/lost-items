---
import { env } from "cloudflare:workers";
import { desc, eq } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import RegisterPage from "~/components/features/register-page";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { items, lists } from "~/server/db/schema";
import { withImageUrl } from "~/server/images";

const { id = "" } = Astro.params;
const db = createDb((env as Bindings).DB);

// Both queries key on the same id and are independent — run them together.
const [list, rawItems] = await Promise.all([
  db.select().from(lists).where(eq(lists.id, id)).get(),
  db
    .select()
    .from(items)
    .where(eq(items.listId, id))
    .orderBy(desc(items.createdAt)),
]);
if (!list) {
  return Astro.redirect("/");
}

const itemList = rawItems.map(withImageUrl);

const title = list.name || "Register Item";
---

<Layout title={title}>
  <AppHeader title={title} />

  <RegisterPage listId={id} items={itemList} client:load />
</Layout>
