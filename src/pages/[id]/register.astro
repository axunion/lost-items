---
import { env } from "cloudflare:workers";
import { eq } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import RegisterForm from "~/components/features/register-form";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { lists } from "~/server/db/schema";

const { id = "" } = Astro.params;
const db = createDb((env as Bindings).DB);

const list = await db.select().from(lists).where(eq(lists.id, id)).get();
if (!list) {
  return Astro.redirect("/");
}

const title = list.name || "Register Item";
---

<Layout title={title}>
  <AppHeader title={title} />

  <main class="register-main">
    <a href={`/${id}/manage`} class="manage-link">
      <span>Manage items</span>
      <svg
        class="manage-link-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m9 18 6-6-6-6"
        />
      </svg>
    </a>

    <RegisterForm listId={id} client:load />
  </main>
</Layout>

<style>
  .register-main {
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .manage-link {
    align-self: flex-end;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }

  .manage-link:hover {
    text-decoration: underline;
  }

  .manage-link-icon {
    width: 1rem;
    height: 1rem;
  }
</style>
