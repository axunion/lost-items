---
import { env } from "cloudflare:workers";
import { and, desc, eq, isNull } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import ItemList from "~/components/features/item-list";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { items, lists } from "~/server/db/schema";

const { id = "" } = Astro.params;
const db = createDb((env as Bindings).DB);

const list = await db.select().from(lists).where(eq(lists.id, id)).get();
if (!list) {
	return Astro.redirect("/");
}

const rawItems = await db
	.select()
	.from(items)
	.where(and(eq(items.listId, id), isNull(items.deletedAt)))
	.orderBy(desc(items.createdAt));

const itemList = rawItems.map(({ imageKey, ...rest }) => ({
	...rest,
	imageUrl: imageKey ? `/api/images/${imageKey}` : null,
}));

const title = list.name || "Room Items";
---

<Layout title={title}>
  <AppHeader title={title} />

  <main class="room-main">
    <ItemList items={itemList} listId={id} readonly client:visible />
  </main>
</Layout>

<style>
  .room-main {
    padding: 1.5rem 1rem;
  }
</style>
