---
import { env } from "cloudflare:workers";
import { and, desc, eq, isNull } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import ItemList from "~/components/features/item-list";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { items, lists } from "~/server/db/schema";
import { toPublicItem } from "~/server/images";

// The public room URL carries the read-only publicId, never the admin id.
const { id: publicId = "" } = Astro.params;
const db = createDb((env as Bindings).DB);

const list = await db
  .select()
  .from(lists)
  .where(eq(lists.publicId, publicId))
  .get();
if (!list) {
  return Astro.redirect("/");
}

const rawItems = await db
  .select()
  .from(items)
  .where(and(eq(items.listId, list.id), isNull(items.deletedAt)))
  .orderBy(desc(items.createdAt));

// Island props are serialized into the public page HTML, so each item's
// listId (the admin id) must be replaced with the publicId before hydration.
const itemList = rawItems.map((item) => toPublicItem(item, list.publicId));

const title = list.name || "Room Items";
---

<Layout title={title}>
  <AppHeader title={title} />

  <main class="room-main">
    <ItemList items={itemList} listId={publicId} readonly client:visible />
  </main>
</Layout>

<style>
  .room-main {
    padding: 1.5rem var(--content-padding-inline);
  }
</style>
