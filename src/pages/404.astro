---
import AppHeader from "~/components/astro/app-header.astro";
import Layout from "~/layouts/layout.astro";
---

<Layout title="Page Not Found">
  <AppHeader title="Not Found" />

  <main class="not-found-main">
    <div class="not-found-content">
      <div class="not-found-icon-wrapper">
        <svg class="not-found-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
            <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2zm6-5h.01"/>
            <path d="M9.1 9a3 3 0 0 1 5.82 1c0 2-3 3-3 3"/>
          </g>
        </svg>
      </div>

      <div class="not-found-text">
        <h1 class="not-found-heading">Page Not Found</h1>
        <p class="not-found-desc">
          The page you're looking for doesn't exist or has been removed.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  .not-found-main {
    padding: 3rem 1rem;
  }

  .not-found-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .not-found-icon-wrapper {
    background-color: var(--color-secondary-alpha-50);
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-muted-foreground);
  }

  .not-found-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .not-found-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0;
  }

  .not-found-desc {
    color: var(--color-muted-foreground);
    margin: 0;
  }
</style>
