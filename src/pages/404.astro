---
import { Icon } from "astro-icon/components";
import AppHeader from "~/components/astro/app-header.astro";
import Layout from "~/layouts/layout.astro";
---

<Layout title="Page Not Found">
  <AppHeader title="Not Found" />

  <main class="not-found-main">
    <div class="not-found-content">
      <div class="not-found-icon-wrapper">
        <Icon name="lucide:file-question" class="not-found-icon" />
      </div>

      <div class="not-found-text">
        <h1 class="not-found-heading">Page Not Found</h1>
        <p class="not-found-desc">
          The page you're looking for doesn't exist or has been removed.
        </p>
      </div>

      <a href="/" class="not-found-link">
        <Icon name="lucide:home" class="not-found-link-icon" />
        Back to Home
      </a>
    </div>
  </main>
</Layout>

<style>
  .not-found-main {
    padding: 3rem 1rem;
  }

  .not-found-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .not-found-icon-wrapper {
    background-color: var(--color-secondary-alpha-50);
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-muted-foreground);
  }

  .not-found-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .not-found-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0;
  }

  .not-found-desc {
    color: var(--color-muted-foreground);
    margin: 0;
  }

  .not-found-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    border-radius: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .not-found-link:hover {
    background-color: var(--color-primary-alpha-90);
  }

  .not-found-link-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
