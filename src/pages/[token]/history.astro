---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import HistoryList from "~/components/features/history-list";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { lists } from "~/server/db/schema";

const { token } = Astro.params;
if (token !== (env as Bindings).ADMIN_TOKEN) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const db = createDb((env as Bindings).DB);
// Bounds the SSR query cost; no pagination UI exists yet, so rooms beyond
// the 100 most recent won't appear here until pagination is added.
const allLists = await db
  .select()
  .from(lists)
  .orderBy(desc(lists.createdAt))
  .limit(100);
---

<Layout title="History">
  <AppHeader title="History" showBack backUrl={`/${token}/dashboard`} />

  <main class="history-main">
    <HistoryList lists={allLists} origin={Astro.url.origin} client:idle />
  </main>
</Layout>

<style>
  .history-main {
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
