---
import { env } from "cloudflare:workers";
import { desc } from "drizzle-orm";
import AppHeader from "~/components/astro/app-header.astro";
import Dashboard from "~/components/features/dashboard";
import Layout from "~/layouts/layout.astro";
import type { Bindings } from "~/server/bindings";
import { createDb } from "~/server/db";
import { lists } from "~/server/db/schema";

const { token } = Astro.params;
if (token !== (env as Bindings).ADMIN_TOKEN) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const db = createDb((env as Bindings).DB);
const recentLists = await db
  .select()
  .from(lists)
  .orderBy(desc(lists.createdAt))
  .limit(3);
---

<Layout title="Dashboard">
  <AppHeader title="Dashboard" />

  <Dashboard
    lists={recentLists}
    origin={Astro.url.origin}
    historyHref={`/${token}/history`}
    client:load
  />
</Layout>
